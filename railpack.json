{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22"
  },
  "steps": {
    "frontend-build": {
      "inputs": [
        {
          "step": "packages:mise",
          "include": ["/mise/shims", "/mise/installs"]
        },
        {
          "local": true,
          "include": ["frontend"]
        }
      ],
      "commands": [
        "npm --prefix frontend ci",
        "npm --prefix frontend run build"
      ],
      "deployOutputs": [
        {
          "include": ["dist"]
        }
      ]
    }
  },
  "deploy": {
    "inputs": [
      "...",
      {
        "step": "frontend-build",
        "include": ["frontend/dist"]
      }
    ],
    "startCommand": "python -m backend.app.db.seed --if-empty && python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8000}"
  }
}